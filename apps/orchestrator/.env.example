DATABASE_URL=postgresql://creditflow:creditflow@localhost:5432/creditflow?schema=public
REDIS_URL=redis://localhost:6379
SCORING_SERVICE_URL=http://localhost:8000
PORT=3001

# Gotcha: Prisma's client searches upward from packages/db/prisma/schema.prisma for a
# .env file if one isn't already resolved, so a stray .env at the repo root with a
# different DATABASE_URL silently wins over this file. Keep only one real .env alive at a
# time across the monorepo (this one is the one that matters for the orchestrator).
