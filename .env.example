# Postgres
DATABASE_URL=postgresql://creditflow:creditflow@localhost:5432/creditflow?schema=public
POSTGRES_USER=creditflow
POSTGRES_PASSWORD=creditflow
POSTGRES_DB=creditflow

# Redis
REDIS_URL=redis://localhost:6379

# Scoring service (FastAPI)
SCORING_SERVICE_URL=http://localhost:8000
SCORECARD_MODEL_PATH=/app/artifacts/scorecard-v1.2.json
CHALLENGER_MODEL_PATH=/app/artifacts/xgb-v0.4.json

# Orchestrator (NestJS)
PORT=3001
CONSOLE_ORIGIN=http://localhost:3000
IDEMPOTENCY_KEY_TTL_SECONDS=86400
BUREAU_MOCK_LATENCY_MS_MIN=200
BUREAU_MOCK_LATENCY_MS_MAX=800
BUREAU_MOCK_TIMEOUT_RATE=0.02
BUREAU_MOCK_ERROR_RATE=0.01
BUREAU_CIRCUIT_BREAKER_FAILURE_THRESHOLD=5

# Console (Next.js)
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001
